# Add approved values in Vercel Project Settings > Environment Variables.
# Never commit secret values. Use Preview first and test before Production.
PUBLIC_SITE_URL=https://www.revlineutah.com

# Stripe: only the publishable key may be sent to the browser.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS=
STRIPE_SUCCESS_URL=https://www.revlineutah.com/payment-success.html?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://www.revlineutah.com/payments/

# Google Business Profile Reviews API OAuth (server-side credentials only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Supabase Reviews moderation (service role key stays server-side).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REVIEWS_TABLE=revline_reviews
SUPABASE_REVIEWS_BUCKET=revline-review-photos

# Optional approved analytics; no ID is embedded by default.
GTM_CONTAINER_ID=
